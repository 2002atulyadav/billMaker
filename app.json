{
  "expo": {
    "name": "Dhanzo",
    "slug": "dhanzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dhanzo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-ios-dark.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      },
      "bundleIdentifier": "app.dhanzo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6FEB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.dhanzo",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6FEB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "hi"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone so you can speak bill items.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to turn your speech into bill items.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your bills."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
